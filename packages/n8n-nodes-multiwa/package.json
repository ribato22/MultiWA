{
  "name": "n8n-nodes-multiwa",
  "version": "1.0.0",
  "description": "n8n nodes for MultiWA WhatsApp Business API Gateway",
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "whatsapp",
    "multiwa",
    "messaging"
  ],
  "license": "MIT",
  "author": {
    "name": "MultiWA Team",
    "email": "dev@multiwa.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ribato22/MultiWA.git",
    "directory": "packages/n8n-nodes-multiwa"
  },
  "homepage": "https://github.com/ribato22/MultiWA/tree/main/packages/n8n-nodes-multiwa#readme",
  "bugs": {
    "url": "https://github.com/ribato22/MultiWA/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp -f src/nodes/MultiWA/multiwa.svg dist/nodes/MultiWA/multiwa.svg",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lintfix": "eslint . --fix"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.15"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MultiWAApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MultiWA/MultiWA.node.js",
      "dist/nodes/MultiWA/MultiWATrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "gulp": "^5.0.1",
    "n8n-workflow": "^2.16.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}