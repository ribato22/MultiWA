# MultiWA — Minimal Configuration
# Just copy this to .env and run: docker compose up -d

# Database (auto-configured by Docker)
DATABASE_URL="postgresql://multiwa:multiwa123@postgres:5432/multiwa?schema=public"
REDIS_URL="redis://redis:6379"

# API
API_PORT=3333
API_HOST=0.0.0.0
# Secrets are auto-generated on first boot (strong + unique, persisted to the
# sessions volume) — no action needed to try MultiWA locally. To pin your own,
# uncomment and set all three:
#   JWT_SECRET="$(openssl rand -base64 48)"
#   JWT_REFRESH_SECRET="$(openssl rand -base64 48)"
#   ENCRYPTION_KEY="$(openssl rand -hex 32)"   # 32-byte hex; keep it stable
CORS_ORIGINS="http://localhost:3001,http://localhost:3333"

# Admin Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3333"

# WhatsApp Engine (whatsapp-web-js or baileys)
DEFAULT_ENGINE=whatsapp-web-js
