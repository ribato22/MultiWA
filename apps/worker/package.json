{
  "name": "@multiwa/worker",
  "version": "1.3.0",
  "private": true,
  "description": "MultiWA Background Worker (BullMQ)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@multiwa/core": "workspace:*",
    "@multiwa/database": "workspace:*",
    "@multiwa/engine-runtime": "workspace:*",
    "@multiwa/engines": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^7.10.1",
    "bullmq": "6.1.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.0",
    "pino": "^10.4.0",
    "prom-client": "^15",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
