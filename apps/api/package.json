{
  "name": "@multiwa/api",
  "version": "1.3.0",
  "private": true,
  "description": "MultiWA Gateway REST API (NestJS + Fastify)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --exclude '**/tenant-route-coverage.spec.ts'",
    "test:meta": "vitest run src/common/tenant/tenant-route-coverage.spec.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@multiwa/core": "workspace:*",
    "@multiwa/database": "workspace:*",
    "@multiwa/engine-runtime": "workspace:*",
    "@multiwa/engines": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "bullmq": "6.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.4",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
