# MultiWA v1.0.0 - Environment Configuration
# Copy to .env and configure for your environment

# ==============================================
# DATABASE
# ==============================================
DATABASE_URL="postgresql://multiwa:multiwa123@localhost:5432/multiwa_gateway?schema=public"

# ==============================================
# REDIS (Cache + Queue)
# ==============================================
REDIS_URL="redis://localhost:6379"

# ==============================================
# API SERVICE
# ==============================================
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"
# Behind a reverse proxy: its address or CIDR (comma-separated), so rate limits and
# logins see the client's address. Leave empty when clients reach the API directly.
TRUST_PROXY=

# ==============================================
# AUTHENTICATION
# ==============================================
# Generate strong values before deploying (required in production — the API
# refuses to boot with a missing/default secret when NODE_ENV=production):
#   JWT_SECRET / JWT_REFRESH_SECRET:  openssl rand -base64 48
#   ENCRYPTION_KEY:                   openssl rand -hex 32   (32-byte hex, keep stable)
# Under Docker these auto-generate on first boot if left unset (see docker/entrypoint-api.sh).
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
# 32-byte hex key used to encrypt integration credentials at rest. Must stay
# stable across restarts or previously-encrypted secrets become undecryptable.
ENCRYPTION_KEY="change-me-to-a-32-byte-hex-key-openssl-rand-hex-32"

# ==============================================
# ADMIN DASHBOARD
# ==============================================
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ==============================================
# ENVIRONMENT
# ==============================================
NODE_ENV=development

# Demo mode (set to true for read-only showcase)
DEMO_MODE=false

# ==============================================
# WHATSAPP ENGINE
# ==============================================
# Options: whatsapp-web-js, baileys
DEFAULT_ENGINE=whatsapp-web-js

# Durable sending: when true, outbound sends are enqueued (Redis-backed) and
# delivered by an in-process consumer with retry — the API returns 202 "queued"
# and delivery is reported via message.status + message.sent/failed webhooks.
# Default (unset/false) = synchronous send. OUTBOUND_SEND_CONCURRENCY tunes it.
DURABLE_SEND=false
# OUTBOUND_SEND_CONCURRENCY=10

# Session storage directory
SESSIONS_DIR=./sessions

# Puppeteer options (for whatsapp-web-js)
PUPPETEER_HEADLESS=true
PUPPETEER_NO_SANDBOX=false

# ==============================================
# WEBHOOKS
# ==============================================
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_MS=30000
# SSRF guard: by default webhook/custom-AI targets that resolve to loopback,
# private, or link-local addresses are BLOCKED (cloud metadata is always
# blocked). Self-hosted deployments that deliver to internal services on the
# same network (Chatwoot, Typebot, n8n, localhost) set this to true to allow
# private targets. Leave false for public / multi-tenant deployments.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ==============================================
# STORAGE (Media files)
# ==============================================
STORAGE_TYPE=local  # local or s3
STORAGE_PATH=./media    

# S3/MinIO (if STORAGE_TYPE=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=multiwa-media

# ==============================================
# SEND POLICY ENGINE (anti-ban pacing + cold circuit) — all optional
# ==============================================
# Cold-lane default daily cap when a profile sets neither coldDailyLimit nor dailyMessageLimit.
COLD_DEFAULT_DAILY_LIMIT=250
# Cold circuit breaker: opens when <MIN_SUCCESS of the last WINDOW terminal cold acks
# were delivered (min SAMPLES), and half-opens after COOLDOWN_MS.
COLD_CIRCUIT_WINDOW=10
COLD_CIRCUIT_MIN_SUCCESS=0.4
COLD_CIRCUIT_MIN_SAMPLES=5
COLD_CIRCUIT_COOLDOWN_MS=1800000
# The longest one WhatsApp send may take before it fails with 504 SEND_TIMEOUT (ms).
# Raise it for large media over a slow link.
SEND_TIMEOUT_MS=60000

# ==============================================
# OTP FAILOVER (Phase 3) — secondary template channel, all optional
# ==============================================
# How long to wait for a delivered/read ack on the primary WhatsApp number before
# failing over to the secondary channel.
OTP_ACK_TIMEOUT_MS=8000
# Secondary channel = a generic template-send HTTP endpoint (any provider). Leave
# OTP_FALLBACK_URL empty to disable failover. Values are deployment-specific.
OTP_FALLBACK_URL=
OTP_FALLBACK_COMPANY_UUID=
OTP_FALLBACK_TEMPLATE_UUID=
OTP_FALLBACK_CHATBOT_UUID=
OTP_FALLBACK_VAR_KEY={{1}}
# Optional auth header — set both only if the provider authenticates via a header
# (e.g. OTP_FALLBACK_AUTH_HEADER=Authorization, OTP_FALLBACK_TOKEN="Bearer <token>").
OTP_FALLBACK_AUTH_HEADER=
OTP_FALLBACK_TOKEN=
# Abort the fallback HTTP request if the provider doesn't respond in time.
OTP_FALLBACK_TIMEOUT_MS=10000

# ==============================================
# CALLS — answering in the dashboard (phase 2, in development)
# ==============================================
# Launches WhatsApp Web with call-media hooks (fake devices, muted, injected microphone). Leave false until
# the dashboard answering feature is released; changing it needs an api restart. It only applies where the api
# hosts the WhatsApp engines (ENGINE_HOST=api, the default) and is ignored with ENGINE_HOST=worker.
CALLS_MEDIA_ENABLED=false
# One UDP+TCP port for all call media. Compose publishes it, on the same number, only with the override added:
#   docker compose -f docker-compose.yml -f docker-compose.calls-media.yml up -d
# Agents' PCs must reach it (firewall: the agents' subnet → this host, UDP preferred, TCP as the fallback).
CALLS_MEDIA_PORT=40000
# REQUIRED when CALLS_MEDIA_ENABLED=true: the LAN IP or host name agents' browsers reach the media port on.
CALLS_MEDIA_ANNOUNCED_ADDRESS=
# Optional: the local IPv4 to listen on (default: the first external interface, i.e. the container's). Set it when
# the host has several interfaces or the api uses host networking: it must be the one agents' packets arrive on.
CALLS_MEDIA_LISTEN_IP=
# Optional: ICE servers for agents outside the LAN, JSON, e.g. [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
CALLS_MEDIA_ICE_SERVERS=
# Optional: a call answered in the dashboard is hung up after this many minutes.
CALLS_MAX_TALK_MINUTES=120

# ==============================================
# CALLS — recordings of the calls answered in the dashboard (phase 2, in development)
# ==============================================
# Recordings and their announcements are private: nothing serves them without an owner's or admin's login, and
# recording cannot be turned on unless the storage refuses reads without credentials (checked then, and every night
# at 02:30 server time, when retention runs too).
# Where they go: local or s3 (default: STORAGE_TYPE, else local).
CALL_RECORDINGS_STORAGE=
# One recordings location per MultiWA database: never point two installations, or a restored copy, at the same bucket
# and prefix or the same directory — each night each would delete the other's files.
# Local: a directory of their own on a persistent volume (compose: /data/call-recordings, volume call_recordings),
# not inside or around STORAGE_PATH or SESSIONS_DIR. It must belong to the API's user alone: it is made 0700, and one
# of another user, a shared (sticky) directory such as /tmp, or a symlink is refused. The API image runs as root, so a
# named Docker volume is made 0700; a bind mount must belong to the container's user. Unset or refused, recording
# cannot be turned on.
CALL_RECORDINGS_PATH=
# S3 (with S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY and S3_SECRET_KEY): a private bucket of their own is strongly advised
# (default: S3_BUCKET). S3_PUBLIC_URL, when set to an address other than localhost, is checked too.
CALL_RECORDINGS_BUCKET=
# Key prefix in the bucket (default: call-recordings/). Changing it, or the bucket, leaves the existing recordings behind.
CALL_RECORDINGS_PREFIX=
# Optional server-side encryption of every object: AES256 or aws:kms.
CALL_RECORDINGS_SSE=
# Recordings in progress (the recorder's files until their call ends and they are stored): a directory of their own on
# a persistent volume (compose: /data/call-recordings-tmp, volume call_recordings_tmp), not inside or around
# STORAGE_PATH, SESSIONS_DIR or CALL_RECORDINGS_PATH, belonging to the API's user alone (it is made 0700). Unset or
# refused, recording cannot be turned on; what is stored stays playable, deletable and under retention.
CALL_RECORDINGS_TMP=
